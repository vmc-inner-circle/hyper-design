[
 {
  "id": "daangn-app-35",
  "text": "차단한 이웃에게는 메시지를 보낼 수 없습니다."
 },
 {
  "id": "daangn-app-62",
  "text": "이용이 제한된 계정입니다. 제한 사유와 기간은 고객센터에서 확인해주세요."
 },
 {
  "id": "daangn-app-44",
  "text": "택배를 예약했습니다."
 },
 {
  "id": "daangn-app-30",
  "text": "불편했던 점을 선택해주세요."
 },
 {
  "id": "daangn-app-58",
  "text": "보호조치가 해제되었습니다. 서비스를 다시 이용할 수 있습니다."
 },
 {
  "id": "daangn-app-27",
  "text": "매너 평가"
 },
 {
  "id": "daangn-app-12",
  "text": "내 동네를 설정하면 주변 이웃의 글을 볼 수 있습니다."
 },
 {
  "id": "daangn-app-24",
  "text": "상품의 상태와 사용 기간 등 자세한 내용을 적어주세요."
 },
 {
  "id": "daangn-app-68",
  "text": "채팅방이 없습니다. 관심 있는 글에서 채팅을 시작해보세요."
 },
 {
  "id": "daangn-app-22",
  "text": "현재 위치에 있는 동네를 선택해주세요."
 },
 {
  "id": "daangn-app-87",
  "text": "구매확정 대기 중입니다. 구매자가 확정하면 거래가 마무리됩니다."
 },
 {
  "id": "daangn-app-01",
  "text": "모임을 탈퇴하시겠습니까?"
 },
 {
  "id": "daangn-app-84",
  "text": "안심결제 진행"
 },
 {
  "id": "daangn-app-34",
  "text": "차단했습니다."
 },
 {
  "id": "daangn-app-97",
  "text": "제재에 이의가 있으면 고객센터로 문의해주세요."
 },
 {
  "id": "daangn-app-28",
  "text": "평가는 상대방에게 공개되지 않습니다."
 },
 {
  "id": "daangn-app-80",
  "text": "지원자 정보는 공고 작성자에게만 공개됩니다."
 },
 {
  "id": "daangn-app-46",
  "text": "택배 기사님이 물건을 수거했습니다. 배송 현황은 택배 조회에서 확인할 수 있습니다."
 },
 {
  "id": "daangn-app-49",
  "text": "구매자 보호 수수료는 안심결제 거래를 보호하는 데 쓰입니다. 거래에 문제가 생기면 중재를 지원합니다."
 },
 {
  "id": "daangn-app-73",
  "text": "제재 내역"
 }
]