[
 {
  "id": "daangn-app-35",
  "text": "차단한 이웃에게는 메시지를 보낼 수 없어요"
 },
 {
  "id": "daangn-app-62",
  "text": "이용이 제한된 계정이에요. 제한이 끝나면 다시 로그인할 수 있어요."
 },
 {
  "id": "daangn-app-44",
  "text": "택배를 예약했어요"
 },
 {
  "id": "daangn-app-30",
  "text": "비매너 이유를 선택해주세요"
 },
 {
  "id": "daangn-app-58",
  "text": "보호조치를 해제했어요. 이제 모든 기능을 다시 이용할 수 있어요."
 },
 {
  "id": "daangn-app-27",
  "text": "매너를 평가할까요?"
 },
 {
  "id": "daangn-app-12",
  "text": "내 동네를 설정하면 가까운 이웃의 소식을 볼 수 있어요."
 },
 {
  "id": "daangn-app-24",
  "text": "어떤 물건인지, 얼마나 썼는지 자세히 적어주세요."
 },
 {
  "id": "daangn-app-68",
  "text": "아직 채팅방이 없어요"
