[
 {
  "id": "ai-s-01",
  "text": "서로의 빈칸을 채워 주는 사이"
 },
 {
  "id": "ai-s-02",
  "text": "별 충전"
 },
 {
  "id": "ai-s-03",
  "text": "충전할 별"
 },
 {
  "id": "ai-s-04",
  "text": "잘 맞는 점"
 },
 {
  "id": "ai-s-05",
  "text": "말로 인정받는 날"
 },
 {
  "id": "ai-s-06",
  "text": "먼저 연락하면 반가운 날"
 },
 {
  "id": "ai-s-07",
  "text": "둘 다 금이 0개예요"
 },
 {
  "id": "ai-s-08",
  "text": "지금 가진 별"
 },
 {
  "id": "ai-s-09",
  "text": "1999년 3월 15일 양력 · 오전 8:10 · 서울"
 },
 {
  "id": "ai-s-10",
  "text": "링크를 복사했어요. 11월 6일까지 열려요."
 },
 {
  "id": "ai-s-s1",
  "text": "풀이를 삭제할까요? / 삭제한 풀이는 되돌릴 수 없어요. / 닫기 | 삭제하기"
 },
 {
  "id": "ai-s-s2",
  "text": "태어난 시간을 0시부터 23시 사이로 입력해주세요."
 },
 {
  "id": "ai-s-s3",
  "text": "저장한 풀이가 없어요. 마음에 드는 풀이를 저장하면 여기서 다시 볼 수 있어요."
 },
 {
  "id": "ai-s-s4",
  "text": "링크를 복사했어요."
 },
 {
  "id": "ai-s-s5",
  "text": "태어난 시간을 몰라도 풀이할 수 있어요. 시간을 넣으면 더 정확해져요."
 }
]