 "story": {
  "headline": "자녀는 <em>마음껏 고치고</em>, 부모는 <em>정해진 것만</em> 받아본다",
  "summary": "부모는 묻는 게 미안하고, 자녀는 미완성 계획을 보여주기 조심스러워서 둘 다 말을 아낍니다. 그래서 이 앱은 자녀의 '고치는 공간'과 부모의 '보는 공간'을 나누고, 그 사이를 자녀가 직접 보내는 '소식' 한 통으로 잇습니다. 부모는 캐묻는 대신 '궁금해요'를 한 번 누르면 됩니다.",
  "ideas": [
   {
    "title": "후보는 '정하는 중'으로만 보인다",
    "desc": "자녀 화면에서는 후보가 점선 표시로 모두 보이고 얼마든지 바뀝니다. 부모 화면에서는 그 자리에 '오후는 정하는 중' 한 줄만 보여 오해할 일이 없습니다.",
    "refs": "US1 · US2 · F2 · F3",
    "screens": [
     "plan-day",
     "parent-day"
    ]
   },
   {
    "title": "알림은 모아서 한 통",
    "desc": "확정된 변경만 '보낼 소식'에 쌓이고, 자녀가 보내기를 누를 때만 부모에게 한 번 알림이 갑니다. 후보가 바뀐 것은 자동으로 빠집니다.",
    "refs": "F5 · S1",
    "screens": [
     "planner-home",
     "send-updates",
     "update-digest"
    ]
   },
   {
    "title": "묻는 대신 '궁금해요'",
    "desc": "부모는 궁금한 날에 버튼 하나만 누릅니다. 자녀 홈에 '엄마가 12월 13일을 궁금해하세요'로 모여, 자녀가 편할 때 그 날부터 정하면 됩니다.",
    "refs": "US2 · S5",
    "screens": [
     "parent-day",
     "planner-home"
    ]
   }
  ],
  "roles": [
   {
    "name": "계획하는 자녀 (지은)",
    "sees": [
     "후보까지 모든 항목과 순서 바꾸기",
     "부모에게 보낼 소식 모음과 미리보기",
     "부모가 누른 '궁금해요'"
    ]
   },
   {
    "name": "보기만 하는 부모 (영호·순자)",
    "sees": [
     "확정된 일정만, 큰 글씨로 하루 한 줄",
     "후보 대신 '정하는 중' 표시",
     "지금 내가 할 일 하나와 '궁금해요' 버튼"
    ]
   },
   {
    "name": "함께 가는 가족 (민수·하나)",
    "sees": [
     "내 할 일·준비물만 모은 목록",
     "모이는 곳과 시간"
    ]
   }
  ]
 }
